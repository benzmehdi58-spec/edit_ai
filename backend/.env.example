# ============================================================================
# MedSub / HormoziSub Studio — Phase 2 & 3 AI Environment Variables
# Copy this file to `.env` inside `backend/` (or project root) and fill in keys.
# ============================================================================

# 1. Groq API Key (Free tier: https://console.groq.com/keys)
#    Used for Step 1 Acoustic Word-Level Timestamp Extraction via `whisper-large-v3`.
#    If omitted, the backend automatically falls back to local `faster-whisper`.
GROQ_API_KEY=your_groq_api_key_here

# 2. Google Gemini API Key (Free tier: https://aistudio.google.com/app/apikey)
#    Used for Step 2 Native Algerian Darija Multimodal Correction, Auto-Translation
#    (darija_mixed, ar_fusha, fr, en), and the AI Video Director visual plan.
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Multi-Stock B-Roll API Keys (`services/broll_fetcher.py`)
#    - Unsplash Access Key (Instant free key: https://unsplash.com/oauth/applications)
#      Fetches high-res vertical 9:16 photos and animates them into smooth Ken Burns
#      zoom/pan MP4 B-Roll clips.
#    - Note: Coverr, Wikimedia Commons, Openverse, and Internet Archive work
#      automatically with ZERO API keys required!
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
PIXABAY_API_KEY=
PEXELS_API_KEY=

# ============================================================================
# Optional Runtime Overrides
# ============================================================================
GEMINI_MODEL=gemini-2.5-flash
WHISPER_LOCAL_MODEL=small
HORMOZISUB_MAX_RENDERS=2
HORMOZISUB_X264_PRESET=medium
HORMOZISUB_X264_CRF=16
HORMOZISUB_CORS_ORIGINS=*
