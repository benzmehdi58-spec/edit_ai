# Copy to .env on the server and fill in.
# Your DuckDNS (or own) domain pointing at the VM public IP, e.g. medsub-api.duckdns.org
DOMAIN=medsub-api.duckdns.org
# Your Cloudflare Pages URL (or * while testing)
CORS_ORIGINS=*

GROQ_API_KEY=
GEMINI_API_KEY=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
